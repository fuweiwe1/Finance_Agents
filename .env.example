# Server
PORT=3001

# 模型 API key 请在前端右上角 Agent 面板配置（持久化到 server/.data/，不入仓库）

# ---- M9 每日决策日报推送（仅云端工作流注入；本地 dry run 可不配） ----
# 报告清单（逗号分隔，也可经「设置 → 报告清单 / 应用到云端」写入仓库变量）
# REPORT_WATCHLIST=600519,000001
# 独立报告模型（provider/baseUrl/model 通常存仓库变量；key 存 Secret）
# REPORT_MODEL_PROVIDER=custom-openai
# REPORT_MODEL_BASE_URL=https://api.deepseek.com/v1
# REPORT_MODEL_NAME=deepseek-chat
# REPORT_MODEL_KEY=sk-xxxx
# 飞书群机器人 webhook（存 Secret）
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxx
# 指定运行日期（默认北京时间今天）
# REPORT_DATE=2026-08-28
# 干跑：只打印卡片不推送
# REPORT_DRY=1
