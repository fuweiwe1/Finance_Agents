{
  "name": "finance_agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm run dev -w server\" \"npm run dev -w web\"",
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w server && npm run build -w web",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w web",
    "lint": "eslint .",
    "test": "npm run test -w server && npm run test -w web",
    "test:e2e": "playwright test",
    "test:watch": "npm run test:watch -w server",
    "demo": "npm run demo -w server",
    "eval:agent": "npm run eval:agent -w server",
    "eval:summary": "npm run eval:summary -w server",
    "export:badcases": "npm run export:badcases -w server"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
